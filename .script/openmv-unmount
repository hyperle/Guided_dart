#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-}"
SCRIPT_NAME="$(basename -- "$0")"

log() {
    printf '%s\n' "$*" >&2
}

resolve_device() {
    local device="$1"
    if command -v readlink >/dev/null 2>&1; then
        readlink -f "${device}" 2>/dev/null || printf '%s\n' "${device}"
    else
        printf '%s\n' "${device}"
    fi
}

unmount_device() {
    local device="$1"
    local source=""
    local mounted_at=""

    if [[ ! -e "${device}" ]]; then
        return 1
    fi

    source="$(resolve_device "${device}")"
    if command -v findmnt >/dev/null 2>&1; then
        mounted_at="$(findmnt -rn -S "${source}" -o TARGET 2>/dev/null || true)"
    fi

    if [[ -z "${mounted_at}" ]]; then
        return 1
    fi

    log "Unmounting OpenMV volume ${source} from ${mounted_at}"
    udisksctl unmount -b "${source}"
    return 0
}

unmount_target_path() {
    local target="$1"
    local source=""
    local mountpoint=""

    if [[ -z "${target}" ]]; then
        return 1
    fi

    if [[ "${target}" == /dev/* && -e "${target}" ]]; then
        unmount_device "${target}"
        return $?
    fi

    if command -v findmnt >/dev/null 2>&1; then
        source="$(findmnt -rn -T "${target}" -o SOURCE 2>/dev/null || true)"
        mountpoint="$(findmnt -rn -T "${target}" -o TARGET 2>/dev/null || true)"
        if [[ -n "${source}" && -n "${mountpoint}" && "${mountpoint}" == "${target}" ]]; then
            unmount_device "${source}"
            return $?
        fi
    fi

    return 1
}

unmount_known_openmv_devices() {
    local matched=1
    local device=""

    shopt -s nullglob
    for device in /dev/disk/by-id/usb-MicroPy_pyboard_SDCard_* /dev/disk/by-id/usb-OpenMV_*SDCard* /dev/disk/by-uuid/E661-42F4; do
        if unmount_device "${device}"; then
            matched=0
        fi
    done
    shopt -u nullglob

    return "${matched}"
}

if unmount_target_path "${TARGET}"; then
    exit 0
fi

if unmount_known_openmv_devices; then
    exit 0
fi

if [[ -n "${TARGET}" ]]; then
    log "OpenMV volume is not mounted: ${TARGET}"
else
    log "OpenMV volume is not mounted"
fi
exit 0
