#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

mkdir -p "${REPO_ROOT}/record"
STAMP="$(date +%Y%m%d_%H%M%S)"
OUT="${OPENMV_RECORD:-${REPO_ROOT}/record/openmv_${STAMP}.mjpeg}"
exec "${REPO_ROOT}/.script/camera-view" --record-mjpeg "${OUT}" --record-metadata "$@"
