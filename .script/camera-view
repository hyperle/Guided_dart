#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

"${REPO_ROOT}/.script/openmv-unmount"
trap '"${REPO_ROOT}/.script/openmv-unmount" >/dev/null 2>&1 || true' EXIT

CAMERA_ARGS=()
if [[ -n "${OPENMV_PORT:-}" ]]; then
    CAMERA_ARGS+=(--port "${OPENMV_PORT}")
fi
if [[ -n "${OPENMV_BAUDRATE:-}" ]]; then
    CAMERA_ARGS+=(--baudrate "${OPENMV_BAUDRATE}")
fi

exec python3 "${REPO_ROOT}/Host_tools/guidance/guidance_camera_stream.py" "${CAMERA_ARGS[@]}" "$@"
