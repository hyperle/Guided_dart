#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

OPENMV_PORT="${OPENMV_PORT:-/dev/ttyACM0}"

exec python3 "${REPO_ROOT}/OpenMV_guidance/tools/openmv_cli.py" clear-flash --port "${OPENMV_PORT}" "$@"
