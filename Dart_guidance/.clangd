CompileFlags:
  Add:
    - -ferror-limit=0
    - -Wno-implicit-int
  CompilationDatabase: .
  Compiler: /home/hyperlee/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-gcc
  BuiltinHeaders: QueryDriver
  Remove:
    - -Winvalid-pch
    - -fno-var-tracking-assignments
Diagnostics:
  Suppress:
    - unused-includes
    - unknown_typename
    - unknown_typename_suggest
    - typename_requires_specqual
---
If:
  PathMatch: .*\\.(h|hpp)$
CompileFlags:
  Add:
    - -xc++
    - -std=gnu++20
