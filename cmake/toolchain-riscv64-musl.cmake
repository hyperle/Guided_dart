set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(K230_TOOLCHAIN_DIR "" CACHE PATH "Directory containing riscv64-unknown-linux-musl-gcc")
if(NOT K230_TOOLCHAIN_DIR)
    message(FATAL_ERROR "Set K230_TOOLCHAIN_DIR to the installed RISC-V musl toolchain bin directory")
endif()
set(_prefix "${K230_TOOLCHAIN_DIR}/riscv64-unknown-linux-musl-")
if(NOT EXISTS "${_prefix}gcc" OR NOT EXISTS "${_prefix}g++")
    message(FATAL_ERROR "Missing RISC-V musl C/C++ compilers in K230_TOOLCHAIN_DIR")
endif()
set(CMAKE_C_COMPILER "${_prefix}gcc")
# GCC 12 remains the C compiler and supplies the musl ABI/runtime. For C++
# modules use GCC >= 14, or a Clang frontend with the same sysroot and linker.
execute_process(COMMAND "${_prefix}g++" -dumpfullversion
    OUTPUT_VARIABLE _dart_gcc_version OUTPUT_STRIP_TRAILING_WHITESPACE)
set(K230_MODULE_CXX_COMPILER "$ENV{DART_CXX_COMPILER}" CACHE FILEPATH
    "Module-capable C++ compiler; Clang can reuse the existing GCC musl runtime")
if(K230_MODULE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER "${K230_MODULE_CXX_COMPILER}")
elseif(_dart_gcc_version VERSION_GREATER_EQUAL 14)
    set(CMAKE_CXX_COMPILER "${_prefix}g++")
else()
    find_program(_dart_cross_clang NAMES clang++-21 clang++-20 clang++-19
        HINTS "${CMAKE_CURRENT_LIST_DIR}/../.cache/module-toolchain/bin")
    if(NOT _dart_cross_clang)
        message(FATAL_ERROR "Cross GCC ${_dart_gcc_version} cannot scan named modules. Install Clang >= 19 plus clang-tools, or set K230_MODULE_CXX_COMPILER / DART_CXX_COMPILER")
    endif()
    set(CMAKE_CXX_COMPILER "${_dart_cross_clang}")
endif()
execute_process(COMMAND "${CMAKE_CXX_COMPILER}" --version OUTPUT_VARIABLE _dart_module_cxx_version)
if(_dart_module_cxx_version MATCHES "clang version ([0-9]+)")
    set(_dart_clang_major "${CMAKE_MATCH_1}")
    get_filename_component(_dart_gcc_root "${K230_TOOLCHAIN_DIR}/.." ABSOLUTE)
    get_filename_component(_dart_clang_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    find_program(CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS
        NAMES "clang-scan-deps-${_dart_clang_major}" clang-scan-deps
        HINTS "${_dart_clang_bin}" NO_CMAKE_FIND_ROOT_PATH)
    set(CMAKE_CXX_COMPILER_TARGET riscv64-unknown-linux-musl)
    set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${_dart_gcc_root}")
    set(CMAKE_SYSROOT "${_dart_gcc_root}/riscv64-unknown-linux-musl")
    set(CMAKE_CXX_LINK_FLAGS "-fuse-ld=bfd -B${K230_TOOLCHAIN_DIR}")
endif()
set(CMAKE_AR "${_prefix}ar")
set(CMAKE_RANLIB "${_prefix}ranlib")
set(CMAKE_STRIP "${_prefix}strip")
set(CMAKE_OBJCOPY "${_prefix}objcopy")
set(CMAKE_NM "${_prefix}nm")
set(CMAKE_C_FLAGS_INIT "-march=rv64imafdcv -mabi=lp64d -mcmodel=medany -Os")
set(CMAKE_CXX_FLAGS_INIT "-march=rv64imafdcv -mabi=lp64d -mcmodel=medany -Os")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES K230_TOOLCHAIN_DIR K230_MODULE_CXX_COMPILER)
