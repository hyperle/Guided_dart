{
  // ===== clangd（代码补全/跳转/诊断，读取 build/compile_commands.json）=====
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--background-index",
    "--header-insertion=never",
    "--clang-tidy"
  ],
  "clangd.path": "clangd",

  // ===== CMake（VS Code CMake Tools 扩展）=====
  // 构建目录、生成器和工具链由 CMakePresets.json 拥有：host → build/（主机 + clangd 用
  // 的 compile_commands.json），cross → build-cross/（RISC-V，需先 export
  // K230_TOOLCHAIN_DIR）。不要再用 cmake.configureArgs 无条件指定交叉工具链文件：
  // 本机没装工具链时配置必然失败，build/compile_commands.json 就永远生成不出来，
  // clangd 只能退回没有 -std/-I 的 fallback 命令（std::span/std::expected 全部报错）。
  // 交叉构建请在命令面板选择 "cross" preset。
  "cmake.useCMakePresets": "always",

  // ===== 关闭 MS C/C++ 的 IntelliSense，避免与 clangd 冲突 =====
  "C_Cpp.intelliSenseEngine": "disabled",

  // ===== 目录视图精简 =====
  "files.exclude": {
    "third_party/": true
  },
  "search.exclude": {
    "build/": true,
    "third_party/": true
  },
  "python.analysis.extraPaths": [
    "/home/hyperlee/.kendryte/k230_canmv_stubs/f6ca68a0ed02f8d29d27bcf9681581e9f71209bb"
  ],
  "python.analysis.stubPath": "/home/hyperlee/.kendryte/k230_canmv_pylance/0908f139a3aa00b8/typings",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  }
}
