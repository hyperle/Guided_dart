{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "host (K230 off, clangd compile database)",
      "description": "Host named-module build and linked behavior tests (GCC >= 14 or Clang >= 19 with matching clang-scan-deps).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "DART_CAMERA_K230": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchain-host.cmake"
    },
    {
      "name": "cross",
      "displayName": "cross (RISC-V musl, needs K230_TOOLCHAIN_DIR)",
      "description": "RISC-V musl modules: GCC >= 14, or Clang >= 19 using the existing GCC musl runtime/SDK. Set K230_TOOLCHAIN_DIR and optionally DART_CXX_COMPILER.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchain-riscv64-musl.cmake",
      "cacheVariables": {
        "DART_CAMERA_K230": "ON",
        "DART_IMU_K230": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "K230_TOOLCHAIN_DIR": "$env{K230_TOOLCHAIN_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "cross",
      "configurePreset": "cross"
    }
  ]
}
